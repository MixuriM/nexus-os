#!/bin/sh
# Configuração da ISO da prova de conceito (base sem stack de rede).
# Chamado pelo "lb config". Veja docs/iso-poc.md.
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --binary-image iso-hybrid \
    --debian-installer none \
    --archive-areas main \
    --image-name nexus-os \
    --iso-application "Nexus OS" \
    --iso-volume "Nexus OS" \
    --memtest none \
    --win32-loader false \
    --bootappend-live "boot=live components console=tty0 console=ttyS0,115200n8" \
    "${@}"
