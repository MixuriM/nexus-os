#!/usr/bin/env bash
# Roda os smoke tests da ISO (/usr/share/nexus-os/tests/<nome>.sh) e imprime os marcadores
# NEXUS-SMOKE-BEGIN, -TIME, -END e -DONE, mais -MEM, -MEMPEAK e -DISK (medição de RAM e disco, F3.9).
# Veja docs/integracao-iso.md.
# Uso (root): nexus-smoke [nome...|all]
# O serviço nexus-smoke.service chama "nexus-smoke --cd": lê o CD de rótulo NEXUS_SMOKE, roda e desliga.
set -u

dir=/usr/share/nexus-os/tests
rotulo=NEXUS_SMOKE

erro() { echo "FALHA: $*" >&2; }

# Memória usada em MiB (coluna "used" do free -m) e disco usado em MiB de um caminho.
usado_mib() { LC_ALL=C free -m | awk '/^Mem:/ {print $3}'; }
disco_mib() { df -m --output=used "$1" 2>/dev/null | tail -n 1 | tr -d ' '; }

mede_disco() {
    local c v
    for c in / /var/lib/docker; do
        v=$(disco_mib "$c")
        [ -z "$v" ] || echo "NEXUS-SMOKE-DISK $1:$c $v"
    done
}

# Grava em $1 o maior uso de RAM visto, amostrado a cada 5 s (um teste mais curto que isso pode escapar).
amostra_pico() {
    local maior=0 u
    while :; do
        u=$(usado_mib)
        if [ -n "$u" ] && [ "$u" -gt "$maior" ]; then
            maior=$u
            echo "$maior" >"$1"
        fi
        sleep 5
    done
}

roda() {
    local nome codigo inicio total=0 falhas=0 lista=() u pico=0 arq_pico spid
    for nome in "$@"; do
        if [ "$nome" = all ]; then
            if [ -f "$dir/smoke.list" ]; then
                mapfile -t todos < <(grep -vE '^[[:space:]]*(#|$)' "$dir/smoke.list")
                lista+=("${todos[@]}")
            else
                erro "lista ausente: $dir/smoke.list"
                lista+=("smoke.list")
            fi
        else
            lista+=("$nome")
        fi
    done
    arq_pico=$(mktemp)
    echo 0 >"$arq_pico"
    amostra_pico "$arq_pico" &
    spid=$!
    u=$(usado_mib)
    echo "NEXUS-SMOKE-MEM repouso ${u:-0}"
    pico=${u:-0}
    mede_disco repouso
    for nome in "${lista[@]}"; do
        total=$((total + 1))
        echo "NEXUS-SMOKE-BEGIN $nome"
        inicio=$SECONDS
        if [[ $nome =~ ^[A-Za-z0-9_-]+$ ]] && [ -f "$dir/$nome.sh" ]; then
            bash "$dir/$nome.sh" </dev/null
            codigo=$?
        else
            erro "teste ausente: $dir/$nome.sh"
            codigo=127
        fi
        [ "$codigo" -eq 0 ] || falhas=$((falhas + 1))
        echo "NEXUS-SMOKE-TIME $nome $((SECONDS - inicio))"
        echo "NEXUS-SMOKE-END $nome $codigo"
        u=$(usado_mib)
        echo "NEXUS-SMOKE-MEM $nome ${u:-0}"
        [ "${u:-0}" -le "$pico" ] || pico=$u
    done
    mede_disco fim
    kill "$spid" 2>/dev/null
    wait "$spid" 2>/dev/null
    u=$(cat "$arq_pico")
    rm -f "$arq_pico"
    [ "$u" -le "$pico" ] || pico=$u
    echo "NEXUS-SMOKE-MEMPEAK $pico"
    echo "NEXUS-SMOKE-DONE $total $falhas"
    [ "$falhas" -eq 0 ]
}

# Modo do serviço: monta o CD, copia extra/*.sh para o diretório de testes, roda e desliga.
cd_modo() {
    local dev mnt rc nomes=() extra
    dev=$(/usr/sbin/blkid -L "$rotulo") || { erro "CD $rotulo ausente"; exit 1; }
    # Só CD-ROM (sr*): pendrive USB com esse rótulo não pode rodar script como root.
    case $(basename "$(readlink -f "$dev")") in
        sr[0-9]*) ;;
        *) erro "$dev não é CD-ROM, recusado"; exit 1 ;;
    esac
    mnt=$(mktemp -d)
    if mount -o ro "$dev" "$mnt" && [ -f "$mnt/testes.txt" ]; then
        mapfile -t nomes < <(grep -vE '^[[:space:]]*$' "$mnt/testes.txt" | tr -d '\r')
        for extra in "$mnt"/extra/*.sh; do
            [ -f "$extra" ] && cp -f "$extra" "$dir/"
        done
    fi
    umount "$mnt" 2>/dev/null
    rmdir "$mnt" 2>/dev/null
    if [ ${#nomes[@]} -eq 0 ]; then
        erro "o CD $rotulo não trouxe testes.txt com testes"
        echo "NEXUS-SMOKE-DONE 0 1"
        rc=1
    else
        roda "${nomes[@]}"
        rc=$?
    fi
    systemctl --no-block poweroff
    exit "$rc"
}

if [ "$(id -u)" -ne 0 ]; then
    erro "rode como root: sudo nexus-smoke [nome...|all]"
    exit 1
fi
case ${1:-} in
    --cd) cd_modo ;;
    "") erro "uso: nexus-smoke [nome...|all]"; exit 2 ;;
    *) roda "$@" ;;
esac
