#!/bin/sh
# Hook do Nexus OS (roda dentro do chroot): habilita as unidades e cria os links dos comandos.
# Cada componente acrescenta as suas linhas abaixo. Veja docs/integracao-iso.md.
set -e

# Os includes do live-build mantêm o modo do repositório, que no Windows perde o bit de execução.
chmod 0755 /usr/local/bin/nexus-smoke

# F3.2: Open vSwitch
systemctl enable openvswitch-switch.service
ln -sf /usr/share/nexus-os/sdn/lab-ovs.sh /usr/local/bin/nexus-sdn
chmod 0755 /usr/share/nexus-os/sdn/lab-ovs.sh

# F3.3: KVM/QEMU e libvirt (o libvirtd.service ativa os três sockets pelo Also=)
systemctl enable libvirtd.service
ln -sf /usr/share/nexus-os/nfv/libvirt/nexus-vm.sh /usr/local/bin/nexus-vm
chmod 0755 /usr/share/nexus-os/nfv/libvirt/nexus-vm.sh
# O pacote cria a rede default sem autostart (o postinst não roda o virsh no chroot): mesmo efeito de virsh net-autostart default.
ln -sf /etc/libvirt/qemu/networks/default.xml /etc/libvirt/qemu/networks/autostart/default.xml

# F3.4: Docker e imagens offline (o nexus-images.service carrega /var/lib/nexus-os/images/*.tar sem rede)
systemctl enable docker.service
systemctl enable nexus-images.service
chmod 0755 /usr/local/bin/nexus-images-load

# F3.5: FRRouting do pacote frr (configuração de exemplo em /usr/share/nexus-os/nfv/frr/exemplo)
systemctl enable frr.service

# F3.7: Containerlab (o .deb vem de live-build/config/packages.chroot/, veja scripts/prepare-offline.sh)

# F3.6: orquestração simplificada da VNF FRR (usa Docker e Containerlab)
ln -sf /usr/share/nexus-os/nfv/nexus-vnf.sh /usr/local/bin/nexus-vnf
chmod 0755 /usr/share/nexus-os/nfv/nexus-vnf.sh

# Smoke test (só age com o CD NEXUS_SMOKE)
systemctl enable nexus-smoke.service

# F3.15 e F3.16: desktop XFCE (o lightdm do pacote vira o display-manager; o live-config faz o login
# automático do user) e atalhos do menu e da área de trabalho. O xfdesktop só confia em atalho executável.
chmod 0755 /usr/local/bin/nexus-atalho /usr/local/bin/nexus-atalhos-confiar
chmod 0755 /etc/skel/Desktop/nexus-*.desktop

# F3.17: identidade visual. O menu da barra do XFCE ganha o nome e o ícone do Nexus OS, o tema Greybird vira o
# padrão das janelas e do GTK, e o papel de parede do Nexus OS entra como alternativa do Debian (cobre
# monitores com outro nome; o xfce4-desktop.xml cobre monitor0 e monitor1). /etc/os-release não muda.
gtk-update-icon-cache -f /usr/share/icons/hicolor
perl -0pi -e 's|<property name="plugin-1" type="string" value="applicationsmenu"/>|<property name="plugin-1" type="string" value="applicationsmenu">\n        <property name="button-title" type="string" value="Nexus OS"/>\n        <property name="button-icon" type="string" value="nexus-os"/>\n        <property name="show-button-title" type="bool" value="true"/>\n      </property>|' /etc/xdg/xfce4/panel/default.xml
grep -q 'value="Nexus OS"' /etc/xdg/xfce4/panel/default.xml
sed -i 's|<property name="ThemeName" type="string" value="Xfce"/>|<property name="ThemeName" type="string" value="Greybird"/>|' /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
grep -q 'value="Greybird"' /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background /usr/share/backgrounds/nexus-os/papel-de-parede.png 90
