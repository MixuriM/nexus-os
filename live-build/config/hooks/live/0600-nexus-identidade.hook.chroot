#!/bin/sh
# Hook do Nexus OS (roda dentro do chroot): identidade visual do desktop (F3.17). Veja docs/branding.md.
# A barra (menu Nexus OS, lançadores, janelas abertas em baixo, sem seletor de áreas de trabalho) vem pronta em
# /etc/xdg/xfce4/panel/default.xml. Aqui o tema Nexus-Dark, os ícones Nexus (sobre o Papirus-Dark) e a fonte Inter
# viram o padrão do GTK e das janelas, e o papel de parede do Nexus OS entra como alternativa do Debian (cobre
# monitores com outro nome; o xfce4-desktop.xml cobre Virtual-1, monitor0 e monitor1). O /etc/os-release não muda:
# a base continua Debian.
set -e

config=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml

gtk-update-icon-cache -f /usr/share/icons/hicolor
gtk-update-icon-cache -f /usr/share/icons/Nexus
fc-cache -f

sed -i -e 's|<property name="ThemeName" type="string" value="Xfce"/>|<property name="ThemeName" type="string" value="Nexus-Dark"/>|' \
    -e 's|<property name="IconThemeName" type="string" value="Tango"/>|<property name="IconThemeName" type="string" value="Nexus"/>|' \
    -e 's|<property name="FontName" type="string" value="Sans 10"/>|<property name="FontName" type="string" value="Inter 10"/>|' \
    -e 's|<property name="MonospaceFontName" type="string" value="Monospace 10"/>|<property name="MonospaceFontName" type="string" value="DejaVu Sans Mono 10"/>|' "$config"
grep -q 'value="Nexus-Dark"' "$config"
grep -q 'value="Nexus"' "$config"
grep -q 'value="Inter 10"' "$config"

update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background /usr/share/backgrounds/nexus-os/papel-de-parede.png 90

# A tela não bloqueia sozinha: o lightdm recomenda o light-locker, que o desktop não usa
if dpkg -s light-locker >/dev/null 2>&1; then
    apt-get purge -y light-locker
fi
