#!/bin/sh
# Hook do Nexus OS (roda dentro do chroot): identidade visual do desktop (F3.17). Veja docs/branding.md.
# O menu da barra do XFCE ganha o nome e o ícone do Nexus OS, a barra fica maior, o tema Nexus-Dark, os
# ícones Papirus-Dark e a fonte Inter viram o padrão do GTK e das janelas, e o papel de parede do Nexus OS
# entra como alternativa do Debian (cobre monitores com outro nome; o xfce4-desktop.xml cobre Virtual-1,
# monitor0 e monitor1). O /etc/os-release não muda: a base continua Debian.
set -e

painel=/etc/xdg/xfce4/panel/default.xml
config=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml

gtk-update-icon-cache -f /usr/share/icons/hicolor
fc-cache -f

perl -0pi -e 's|<property name="plugin-1" type="string" value="applicationsmenu"/>|<property name="plugin-1" type="string" value="applicationsmenu">\n        <property name="button-title" type="string" value="Nexus OS"/>\n        <property name="button-icon" type="string" value="nexus-os"/>\n        <property name="show-button-title" type="bool" value="true"/>\n      </property>|' "$painel"
grep -q 'value="Nexus OS"' "$painel"
sed -i -e 's|<property name="size" type="uint" value="26"/>|<property name="size" type="uint" value="38"/>|' \
    -e 's|<property name="icon-size" type="uint" value="16"/>|<property name="icon-size" type="uint" value="0"/>|' "$painel"
grep -q 'name="size" type="uint" value="38"' "$painel"

sed -i -e 's|<property name="ThemeName" type="string" value="Xfce"/>|<property name="ThemeName" type="string" value="Nexus-Dark"/>|' \
    -e 's|<property name="IconThemeName" type="string" value="Tango"/>|<property name="IconThemeName" type="string" value="Papirus-Dark"/>|' \
    -e 's|<property name="FontName" type="string" value="Sans 10"/>|<property name="FontName" type="string" value="Inter 10"/>|' \
    -e 's|<property name="MonospaceFontName" type="string" value="Monospace 10"/>|<property name="MonospaceFontName" type="string" value="DejaVu Sans Mono 10"/>|' "$config"
grep -q 'value="Nexus-Dark"' "$config"
grep -q 'value="Papirus-Dark"' "$config"
grep -q 'value="Inter 10"' "$config"

update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background /usr/share/backgrounds/nexus-os/papel-de-parede.png 90
