# Artefatos de build do live-build (a pasta config/ deve ser versionada)
chroot/
binary/
cache/
.build/
live-build/local/
*.iso
*.img
live-image-*
*.contents
*.files
*.packages
*.log

# Saída do scripts/build-iso.sh (ISO e SHA256 nunca entram no Git)
dist/

# Gerados pelo "lb config" a cada build (o auto/config os recria)
live-build/config/binary
live-build/config/bootstrap
live-build/config/chroot
live-build/config/common
live-build/config/source
live-build/config/package-lists/live.list.chroot
live-build/config/hooks/live/*
!live-build/config/hooks/live/*nexus-*
live-build/config/hooks/normal/
live-build/config/includes.chroot/usr/share/nexus-os/
live-build/config/includes.chroot/var/lib/nexus-os/
live-build/binary.modified_timestamps
live-build/chroot.packages.*

# Runtime do Containerlab
clab-*/
.clab.*

# Ansible e segredos
*.retry
.vault_pass*
.env
.env.*
*.pem
*.key

# Lixo de SO e editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Configuração local do Claude Code (settings.json é versionado: só desliga o link de sessão nos commits)
.claude/settings.local.json
